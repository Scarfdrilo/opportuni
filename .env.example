# =============================================================================
# Opportuni — variables de entorno (guía)
# Copia este archivo a `.env.local` y llena los valores. NO subas `.env.local`.
# Las que empiezan con NEXT_PUBLIC_ se exponen al navegador (no pongas secretos).
# =============================================================================

# ---- Accesly SDK (login + wallet) ----
# App ID de tu app en el dashboard de Accesly.
NEXT_PUBLIC_ACCESLY_APP_ID=app_p_xxxxxxxxxxxx

# ---- Pagos de servicios (transferencia XLM) ----
# Dirección Stellar (G... o C...) que recibe el 97% de cada pago.
NEXT_PUBLIC_VIANEY_WALLET=G...
# Dirección Stellar que recibe la comisión del 3% (Accesly).
NEXT_PUBLIC_ACCESLY_FEE_WALLET=G...
# Precio de cada servicio EN XLM (no en pesos).
# Ej. $150 MXN ≈ 44.95863805 XLM ; $300 MXN ≈ 89.9172761 XLM
NEXT_PUBLIC_PRICE_CV_XLM=44.95863805
NEXT_PUBLIC_PRICE_ASESORIA_XLM=89.9172761

# ---- Post-pago ----
# Google Calendar de citas (versión embebible con ?gv=true).
NEXT_PUBLIC_CALENDLY_URL=https://calendar.google.com/calendar/appointments/schedules/XXXX?gv=true

# ---- Dashboard admin (/admin) ----
# Wallet(s) Accesly que pueden entrar al dashboard, separadas por coma.
# La persona entra a /admin y ahí ve su dirección para agregarla aquí.
NEXT_PUBLIC_ADMIN_WALLETS=C...
# (Opcional) Google Calendar/agenda para embeber en "Reuniones".
# Si se deja vacío, usa NEXT_PUBLIC_CALENDLY_URL.
NEXT_PUBLIC_ADMIN_CALENDAR_URL=

# ---- Vercel Blob (almacenamiento de CVs) ----
# SECRETO — no lo expongas. Obténlo en Vercel → Storage → tu Blob store.
# Sin él, la subida cae a ./uploads local (solo dev).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx
# Informativos (opcionales; solo si activas webhooks de Blob):
BLOB_STORE_ID=store_xxxxxxxxxxxx
BLOB_WEBHOOK_PUBLIC_KEY=
